		(uuid "721cd03c-e0c9-4b89-9db6-290117bba8d5")
	)
	(text_box "Handles the charging of the battery and power management of the system. To understand the function of each pin, please refer to the documentation, as most of the connections, resistor and capacitance value selection has been done by following the requirements/recommendations of the datasheet."
		(exclude_from_sim no)
		(at 222.25 144.7799 0)
		(size 45.72 19.0501)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
