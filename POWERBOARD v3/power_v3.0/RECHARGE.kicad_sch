	(text ""
		(exclude_from_sim no)
		(at 240.792 71.374 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "93ec7fb5-a965-459f-a4b3-4a37e517cd92")
	)
	(text_box "R1 was selected to give a max charging current of slightly above 1A, which is the nominal value recommended by the battery datasheet. In theory, we could charge the battery using up to 2A for a faster charge, but since we are trying to limit the temperature rise and are not constrained on the rapidity of the charging system, we chose to limit it to 1A.\nVSET sets the charging voltage (8.4V). A >150kOhm value is recommended for R2. The pin can also be left floating.\nR9 has the value recommended by the datasheet."
		(exclude_from_sim no)
		(at 74.93 68.5799 0)
		(size 63.5 20.3201)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c3d501c-604c-4e55-8016-06f40bfba605")
	)
	(text_box "This bloc is the external connection of the battery to the board. It is not to be mistaken with the CHAR/BATT1 connector used to perform tests on the circuit without unplugging the battery. We use a JST PH connector to give the user the opportunity to plug and unplug the battery."
		(exclude_from_sim no)
		(at 59.69 111.0632 0)
		(size 66.04 12.1268)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "31168909-10f9-44ff-be8f-b73721645020")
	)
	(text_box "BATTERY CONNECTION\n"
		(exclude_from_sim no)
		(at 27.94 91.44 0)
		(size 97.79 31.75)
		(margins 0.9525 0.9525 0.9525 0.9525)
